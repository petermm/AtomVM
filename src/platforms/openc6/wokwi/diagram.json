{
  "version": 1,
  "author": "Antigravity",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-c6-devkitc-1",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {
        "flashSize": "8"
      }
    },
    {
      "type": "wokwi-neopixel",
      "id": "neopixel1",
      "top": -50,
      "left": 180,
      "attrs": {}
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_power",
      "top": 120,
      "left": 180,
      "attrs": { "label": "Power" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:8", "neopixel1:DIN", "green", [ "h0" ] ],
    [ "esp:5V", "neopixel1:VDD", "red", [ "h0" ] ],
    [ "esp:GND.1", "neopixel1:VSS", "black", [ "h0" ] ],
    [ "esp:4", "btn_power:1.l", "blue", [ "h0" ] ],
    [ "esp:GND.2", "btn_power:2.l", "black", [ "h0" ] ]
  ],
  "dependencies": {}
}
