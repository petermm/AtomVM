if(DEFINED DEF_FILE AND DEFINED OUT_FILE AND DEFINED PREFIX)
    # Executed by the host CMake, including during cross compilation.
    file(STRINGS "${DEF_FILE}" LINES)
    set(ATOM_COUNT 0)
    set(MIN_LEN 255)
    set(MAX_LEN 0)
    foreach(line IN LISTS LINES)
        if(line MATCHES "^[ \t]*X[ \t]*\\([ \t]*([A-Za-z0-9_]+)[ \t]*,[ \t]*\"[^\"]*\"[ \t]*,[ \t]*\"([^\"]*)\"[ \t]*\\)")
            set(ATOM_STR "${CMAKE_MATCH_2}")
            # The definitions currently contain only unescaped ASCII strings.
            # Reject escapes rather than silently generating incorrect byte lengths/order.
            if(ATOM_STR MATCHES "\\\\")
                message(FATAL_ERROR "Escaped atom strings are not supported: ${line}")
            endif()
            string(LENGTH "${ATOM_STR}" ATOM_LEN)
            if(ATOM_LEN GREATER 255)
                message(FATAL_ERROR "Default atom exceeds 255 bytes: ${line}")
            endif()
            if(ATOM_LEN LESS MIN_LEN)
                set(MIN_LEN ${ATOM_LEN})
            endif()
            if(ATOM_LEN GREATER MAX_LEN)
                set(MAX_LEN ${ATOM_LEN})
            endif()
            list(APPEND BUCKET_${ATOM_LEN} "${ATOM_STR}:${ATOM_COUNT}")
            math(EXPR ATOM_COUNT "${ATOM_COUNT} + 1")
        elseif(line MATCHES "^[ \t]*X[ \t]*\\(")
            message(FATAL_ERROR "Unsupported default atom definition: ${line}")
        endif()
    endforeach()

    if(ATOM_COUNT GREATER 65535)
        message(FATAL_ERROR "Default atom table exceeds 16-bit offsets")
    elseif(ATOM_COUNT GREATER 255)
        set(INDEX_TYPE uint16_t)
    else()
        set(INDEX_TYPE uint8_t)
    endif()
    if(ATOM_COUNT EQUAL 0)
        set(MIN_LEN 0)
    endif()

    # Partition by length, sorting lexicographically within each partition.
    set(ALL_INDICES "")
    set(OFFSETS "")
    set(CURRENT_OFFSET 0)
    math(EXPR MAX_LEN_PLUS_1 "${MAX_LEN} + 1")
    foreach(L RANGE 0 ${MAX_LEN_PLUS_1})
        list(APPEND OFFSETS ${CURRENT_OFFSET})
        if(DEFINED BUCKET_${L})
            list(SORT BUCKET_${L} COMPARE STRING CASE SENSITIVE ORDER ASCENDING)
            foreach(item IN LISTS BUCKET_${L})
                string(REGEX REPLACE "^.*:([0-9]+)$" "\\1" IDX "${item}")
                list(APPEND ALL_INDICES ${IDX})
                math(EXPR CURRENT_OFFSET "${CURRENT_OFFSET} + 1")
            endforeach()
        endif()
    endforeach()

    string(TOUPPER "${PREFIX}" UPPER_PREFIX)
    set(CONTENT "/* Automatically generated by GenDefaultAtoms.cmake. DO NOT EDIT. */\n\n")
    string(APPEND CONTENT "#ifndef _${UPPER_PREFIX}_DEFAULTATOMS_TABLES_H_\n")
    string(APPEND CONTENT "#define _${UPPER_PREFIX}_DEFAULTATOMS_TABLES_H_\n\n#include <stdint.h>\n\n")
    string(APPEND CONTENT "#define ${UPPER_PREFIX}_DEFAULTATOMS_COUNT ${ATOM_COUNT}\n")
    string(APPEND CONTENT "#define ${UPPER_PREFIX}_DEFAULTATOMS_MIN_LEN ${MIN_LEN}\n")
    string(APPEND CONTENT "#define ${UPPER_PREFIX}_DEFAULTATOMS_MAX_LEN ${MAX_LEN}\n\n")
    list(LENGTH OFFSETS NUM_OFFSETS)
    string(REPLACE ";" ", " OFFSETS "${OFFSETS}")
    string(APPEND CONTENT "static const ${INDEX_TYPE} ${PREFIX}_len_offsets[${NUM_OFFSETS}] = {\n    ${OFFSETS}\n};\n\n")
    if(ATOM_COUNT EQUAL 0)
        string(APPEND CONTENT "static const ${INDEX_TYPE} ${PREFIX}_atoms_by_len[1] = { 0 };\n\n")
    else()
        string(APPEND CONTENT "static const ${INDEX_TYPE} ${PREFIX}_atoms_by_len[${ATOM_COUNT}] = {\n")
        foreach(L RANGE ${MIN_LEN} ${MAX_LEN})
            if(DEFINED BUCKET_${L})
                string(APPEND CONTENT "    /* Length ${L} */\n    ")
                foreach(item IN LISTS BUCKET_${L})
                    string(REGEX REPLACE "^.*:([0-9]+)$" "\\1" IDX "${item}")
                    string(APPEND CONTENT "${IDX}, ")
                endforeach()
                string(APPEND CONTENT "\n")
            endif()
        endforeach()
        string(APPEND CONTENT "};\n\n")
    endif()
    string(APPEND CONTENT "#endif /* _${UPPER_PREFIX}_DEFAULTATOMS_TABLES_H_ */\n")
    if(EXISTS "${OUT_FILE}")
        file(READ "${OUT_FILE}" EXISTING_CONTENT)
        if("${EXISTING_CONTENT}" STREQUAL "${CONTENT}")
            return()
        endif()
    endif()
    file(WRITE "${OUT_FILE}" "${CONTENT}")
else()
    set(GEN_DEFAULT_ATOMS_SCRIPT "${CMAKE_CURRENT_LIST_FILE}" CACHE INTERNAL "")

    function(generate_defaultatoms TARGET_NAME DEF_FILE OUT_FILE PREFIX)
        get_filename_component(OUT_DIR "${OUT_FILE}" DIRECTORY)
        add_custom_command(
            OUTPUT "${OUT_FILE}"
            COMMAND ${CMAKE_COMMAND}
                "-DDEF_FILE=${DEF_FILE}"
                "-DOUT_FILE=${OUT_FILE}"
                "-DPREFIX=${PREFIX}"
                -P "${GEN_DEFAULT_ATOMS_SCRIPT}"
            DEPENDS "${DEF_FILE}" "${GEN_DEFAULT_ATOMS_SCRIPT}"
            COMMENT "Generating ${OUT_FILE} from ${DEF_FILE}"
            VERBATIM
        )
        add_custom_target(${TARGET_NAME}_${PREFIX}_defaultatoms_tables DEPENDS "${OUT_FILE}")
        add_dependencies(${TARGET_NAME} ${TARGET_NAME}_${PREFIX}_defaultatoms_tables)
        target_include_directories(${TARGET_NAME} PRIVATE "${OUT_DIR}")
    endfunction()
endif()
